[Unit]
Description=Keyboard Coach daemon
# Start with the Hyprland session so the compositor socket and session
# environment exist, and stop when the session ends.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=exec
ExecStart=%h/.local/bin/keyboard-coach serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
