{
  "version": 1,
  "entries": [
    {"buttons":["right"],"shortcut":"Shift+F10","description":"open the context menu."},
    {"widgets":["^omarchy.menu$"],"buttons":["left"],"shortcut":"Super+Space","description":"open the Omarchy menu."},
    {"widgets":["^omarchy.workspaces$"],"buttons":["left"],"shortcut":"Super+1…0 / Super+Tab","description":"switch workspaces directly or sequentially."},
    {"surfaces":["^bar$"],"panel_indexes":["^[1-9]$"],"buttons":["left"],"shortcut":"Super+Ctrl+{panel_index}","description":"open the {widget_name} panel."},
    {"namespaces":["^omarchy-menu$"],"shortcut":"↑/↓ + Enter; Esc","description":"navigate, activate, or close the Omarchy menu."},
    {"namespaces":["^omarchy-keyboard-panel$"],"shortcut":"H/J/K/L or arrow keys + Enter; Esc","description":"navigate, activate, or close this Omarchy panel."},
    {"namespaces":["^omarchy-(emojis|clipboard|image-picker)$"],"shortcut":"Arrow keys + Enter; Esc","description":"navigate, activate, or close this Omarchy overlay."},
    {"apps":["nautilus|org.gnome.nautilus"],"names":["new folder"],"shortcut":"Ctrl+Shift+N","description":"create a new folder."},
    {"apps":["nautilus|org.gnome.nautilus"],"names":["rename"],"shortcut":"F2","description":"rename the selected item."},
    {"apps":["nautilus|org.gnome.nautilus"],"names":["\\b(back|previous)\\b"],"shortcut":"Alt+Left","description":"go back."},
    {"apps":["nautilus|org.gnome.nautilus"],"names":["\\bhome\\b"],"shortcut":"Alt+Home","description":"open the home folder."},
    {"apps":["code|codium|cursor"],"names":["new file"],"shortcut":"Ctrl+N","description":"create a new file."},
    {"apps":["code|codium|cursor"],"names":["command palette"],"shortcut":"Ctrl+Shift+P","description":"open the command palette."},
    {"apps":["code|codium|cursor"],"names":["extensions"],"shortcut":"Ctrl+Shift+X","description":"open Extensions."},
    {"apps":["code|codium|cursor"],"names":["source control"],"shortcut":"Ctrl+Shift+G","description":"open Source Control."},
    {"names":["\\bcopy\\b"],"shortcut":"Ctrl+C","description":"copy."},
    {"names":["\\bpaste\\b"],"shortcut":"Ctrl+V","description":"paste."},
    {"names":["\\bcut\\b"],"shortcut":"Ctrl+X","description":"cut."},
    {"names":["\\bundo\\b"],"shortcut":"Ctrl+Z","description":"undo."},
    {"names":["\\bredo\\b"],"shortcut":"Ctrl+Shift+Z","description":"redo."},
    {"names":["\\bsave( as)?\\b"],"shortcut":"Ctrl+S","description":"save."},
    {"names":["\\bprint\\b"],"shortcut":"Ctrl+P","description":"print."},
    {"names":["\\b(find|search)\\b"],"shortcut":"Ctrl+F","description":"find or search."},
    {"names":["\\b(cancel|dismiss|close)\\b"],"roles":["button|push button|menu item"],"shortcut":"Esc","description":"dismiss this control."},
    {"names":["\\b(ok|confirm|apply|submit)\\b"],"roles":["button|push button"],"shortcut":"Enter","description":"activate this control."},
    {"roles":["^(check box|radio button|toggle button)$"],"buttons":["left"],"shortcut":"Space","description":"toggle the focused control."},
    {"roles":["^(button|push button|menu item)$"],"buttons":["left"],"shortcut":"Enter or Space","description":"activate the focused control."},
    {"roles":["^link$"],"buttons":["left"],"shortcut":"Enter","description":"open the focused link."},
    {"roles":["^(list item|tree item)$"],"buttons":["left"],"shortcut":"Arrow keys + Enter","description":"select and open an item."}
  ]
}
