{
  "schema_version": 1,
  "id": "signal-desktop",
  "apps": ["^(signal|signal-desktop|org\\.signal\\.Signal.*)$"],
  "source": {
    "title": "Signal Desktop Keyboard Shortcuts",
    "url": "https://support.signal.org/hc/en-us/articles/360036517511-Signal-Desktop-Keyboard-Shortcuts",
    "platform": "linux",
    "retrieved": "2026-09-10"
  },
  "commands": [
    {"id":"switch-chat","shortcut":"Alt+Up / Alt+Down","description":"switch to the previous or next chat.","priority":220,"match":{"roles":["^(list item|table row)$"],"buttons":["left"]}},
    {"id":"jump-chat","shortcut":"Ctrl+1…9","description":"jump directly to one of the first nine chats."},
    {"id":"previous-chat","shortcut":"Alt+Up / Ctrl+Shift+Tab","description":"switch to the previous chat."},
    {"id":"next-chat","shortcut":"Alt+Down / Ctrl+Tab","description":"switch to the next chat."},
    {"id":"previous-unread-chat","shortcut":"Alt+Shift+Up","description":"switch to the previous unread chat."},
    {"id":"next-unread-chat","shortcut":"Alt+Shift+Down","description":"switch to the next unread chat."},
    {"id":"preferences","shortcut":"Ctrl+,","description":"open Signal Preferences.","priority":220,"match":{"names":["^(preferences|settings)$"],"buttons":["left"]}},
    {"id":"show-shortcuts","shortcut":"Ctrl+/","description":"show all Signal keyboard shortcuts.","match":{"names":["^(show )?keyboard shortcuts$"]}},
    {"id":"navigate-section","shortcut":"Ctrl+T","description":"move focus between Signal sections."},
    {"id":"focus-last-message","shortcut":"Ctrl+J","description":"focus the oldest unread or last message."},
    {"id":"chat-menu","shortcut":"Ctrl+Shift+L","description":"open the current chat menu.","match":{"names":["^(chat|conversation) (menu|settings)$"]}},
    {"id":"new-chat","shortcut":"Ctrl+N","description":"start a new chat.","match":{"names":["^new (chat|conversation|message)$"]}},
    {"id":"search","shortcut":"Ctrl+F","description":"search Signal.","match":{"names":["^search( signal)?$"]}},
    {"id":"search-chat","shortcut":"Ctrl+Shift+F","description":"search within the current chat.","match":{"names":["^search (in )?(this )?(chat|conversation)$"]}},
    {"id":"focus-composer","shortcut":"Ctrl+Shift+T","description":"focus the message composer."},
    {"id":"all-media","shortcut":"Ctrl+Shift+M","description":"open All Media.","match":{"names":["^(all media|media view)$"]}},
    {"id":"emoji-chooser","shortcut":"Ctrl+Shift+J","description":"open the emoji chooser.","match":{"names":["^(emoji|open emoji (picker|chooser))$"]}},
    {"id":"sticker-chooser","shortcut":"Ctrl+Shift+O","description":"open the sticker chooser.","match":{"names":["^(stickers?|open sticker (picker|chooser))$"]}},
    {"id":"gif-chooser","shortcut":"Ctrl+Shift+G","description":"open the GIF chooser.","match":{"names":["^(gifs?|open gif (picker|chooser))$"]}},
    {"id":"record-voice","shortcut":"Ctrl+Shift+Y","description":"begin recording a voice message.","match":{"names":["^(record )?(voice (message|note)|audio)$"]}},
    {"id":"archive-chat","shortcut":"Ctrl+Shift+A","description":"archive the current chat.","match":{"names":["^archive( chat| conversation)?$"]}},
    {"id":"unarchive-chat","shortcut":"Ctrl+Shift+U","description":"unarchive the current chat.","match":{"names":["^unarchive( chat| conversation)?$"]}},
    {"id":"scroll-top","shortcut":"Ctrl+Up","description":"scroll to the top of the chat."},
    {"id":"scroll-bottom","shortcut":"Ctrl+Down","description":"scroll to the bottom of the chat."},
    {"id":"close-chat","shortcut":"Ctrl+Shift+C","description":"close the current chat.","match":{"names":["^close (chat|conversation)$"]}},
    {"id":"message-default","shortcut":"Enter","description":"perform the selected message's default action."},
    {"id":"message-details","shortcut":"Ctrl+D","description":"view details for the selected message.","match":{"names":["^(message details|more info|info)$"]}},
    {"id":"reply","shortcut":"Ctrl+Shift+R","description":"reply to the selected message.","match":{"names":["^reply( to message)?$"]}},
    {"id":"react","shortcut":"Ctrl+Shift+E","description":"react to the selected message.","match":{"names":["^(react|react to message|add reaction)$"]}},
    {"id":"save-attachment","shortcut":"Ctrl+S","description":"save the selected attachment.","match":{"names":["^(save attachment|download( attachment)?)$"]}},
    {"id":"forward-message","shortcut":"Ctrl+Shift+S","description":"forward selected messages.","match":{"names":["^forward( message)?$"]}},
    {"id":"message-menu","shortcut":"Shift+F10","description":"open the selected message's context menu."},
    {"id":"delete-message","shortcut":"Ctrl+Shift+D","description":"delete the selected message.","match":{"names":["^delete( message| for me)?$"]}},
    {"id":"newline","shortcut":"Shift+Enter","description":"add a new line to the message."},
    {"id":"expand-composer","shortcut":"Ctrl+Shift+K","description":"expand the message composer."},
    {"id":"send-expanded","shortcut":"Ctrl+Enter","description":"send from the expanded composer."},
    {"id":"attach-file","shortcut":"Ctrl+U","description":"attach a file.","match":{"names":["^(attach( file)?|add attachment)$"]}},
    {"id":"bold","shortcut":"Ctrl+B","description":"format selected text as bold.","match":{"names":["^bold$"]}},
    {"id":"italic","shortcut":"Ctrl+I","description":"format selected text as italic.","match":{"names":["^italic$"]}},
    {"id":"strikethrough","shortcut":"Ctrl+Shift+X","description":"format selected text as strikethrough.","match":{"names":["^strikethrough$"]}},
    {"id":"monospace","shortcut":"Ctrl+E","description":"format selected text as monospace.","match":{"names":["^monospace$"]}},
    {"id":"spoiler","shortcut":"Ctrl+Shift+B","description":"format selected text as a spoiler.","match":{"names":["^spoiler$"]}},
    {"id":"toggle-mute","shortcut":"Shift+M","description":"toggle microphone mute.","match":{"names":["^(mute|unmute)( mic| microphone)?$"]}},
    {"id":"toggle-video","shortcut":"Shift+V","description":"toggle video.","match":{"names":["^(start|stop|turn on|turn off) (video|camera)$"]}},
    {"id":"start-voice-call","shortcut":"Alt+Shift+C","description":"start a voice call.","match":{"names":["^(start )?(voice|audio) call$"]}},
    {"id":"start-video-call","shortcut":"Alt+Shift+Y","description":"start a video call.","match":{"names":["^(start )?video call$"]}},
    {"id":"end-call","shortcut":"Alt+Shift+E","description":"end the call.","match":{"names":["^(end call|hang up|leave call)$"]}}
  ]
}
