{
  "schema_version": 1,
  "id": "chromium",
  "apps": ["^(brave|brave-browser(-(beta|dev|nightly))?|com\\.brave\\.Browser.*)$", "^(chromium|chromium-browser|org\\.chromium\\.Chromium.*|ungoogled-chromium)$", "^(chrome|google-chrome(-(beta|unstable))?|com\\.google\\.Chrome.*)$", "^(vivaldi|vivaldi-stable|vivaldi-snapshot|com\\.vivaldi\\.Vivaldi.*)$", "^(microsoft-edge(-(beta|dev))?|com\\.microsoft\\.Edge.*)$", "^(thorium|thorium-browser|opera|opera-beta|opera-developer)$", "^(brave|chrome|chromium|vivaldi|microsoft-edge|thorium)-[^-]+-(default|profile[ _]?\\d+)$"],
  "accelerator_source": "chromium_preferences",
  "default_match": {"target_in_document": ["^false$"]},
  "source": {"title": "Chrome, Chromium and Brave keyboard shortcuts", "url": "https://support.google.com/chrome/answer/157179", "brave_url": "https://support.brave.com/hc/en-us/articles/360032272171-What-keyboard-shortcuts-can-I-use-in-Brave", "platform": "linux", "retrieved": "2026-09-20"},
  "commands": [
    {"id":"select-tab-direct","shortcut":"Ctrl+{target_position} / Ctrl+Tab","description":"switch directly to this tab or cycle tabs.","priority":240,"match":{"roles":["^page tab$"],"target_positions":["^[1-8]$"],"buttons":["left"]}},
    {"id":"select-last-tab","shortcut":"Ctrl+9 / Ctrl+Tab","description":"switch to the last tab or cycle tabs.","priority":235,"match":{"roles":["^page tab$"],"target_is_last":["^true$"],"buttons":["left"]}},
    {"id":"select-tab","shortcut":"Ctrl+Tab / Ctrl+Shift+Tab","description":"switch to the next or previous tab.","priority":220,"match":{"roles":["^page tab$"],"buttons":["left"]}},
    {"id":"new-tab","shortcut":"Ctrl+T","description":"open a new tab.","priority":220,"match":{"names":["\\bnew tab\\b"],"buttons":["left"]}},
    {"id":"settings","shortcut":"Alt+F, then S","description":"open Settings from the main menu.","priority":220,"match":{"names":["\\b(settings|preferences)\\b"],"buttons":["left"]}},
    {"id":"main-menu","shortcut":"Alt+F","description":"open the browser's main menu.","priority":210,"match":{"intents":["^open-application-menu$"],"buttons":["left"]}},
    {"id":"new-window","shortcut":"Ctrl+N","description":"open a new window.","match":{"names":["\\bnew window\\b"]}},
    {"id":"new-private-window","shortcut":"Ctrl+Shift+N","description":"open a new private or incognito window.","match":{"names":["new (private|incognito|inprivate) (window|tab)"]}},
    {"id":"reopen-closed-tab","shortcut":"Ctrl+Shift+T","description":"reopen the last closed tab.","match":{"names":["reopen.*closed tab"]}},
    {"id":"close-tab","shortcut":"Ctrl+W","description":"close the current tab.","priority":180,"match":{"names":["\\bclose tab\\b"]}},
    {"id":"close-tab-button","shortcut":"Ctrl+W","description":"close the current tab.","priority":180,"match":{"roles":["^(button|push button)$"],"names":["^close$"],"parent_roles":["^page tab$"],"target_parent_selected":["^true$"]}},
    {"id":"close-window","native_id":34012,"shortcut":"Ctrl+Shift+W","description":"close the current window.","match":{"names":["close window|\\b(exit|quit)\\b"]}},
    {"id":"back","shortcut":"Alt+Left","description":"go back.","match":{"names":["\\b(back|previous)\\b"]}},
    {"id":"forward","shortcut":"Alt+Right","description":"go forward.","match":{"names":["\\b(forward|next)\\b"]}},
    {"id":"home","shortcut":"Alt+Home","description":"open the home page.","match":{"names":["\\bhome\\b"]}},
    {"id":"address-bar","shortcut":"Ctrl+L","description":"focus the address bar.","match":{"names":["address|location|search.*(bar|box)|omnibox"]}},
    {"id":"reload","shortcut":"Ctrl+R","description":"reload the page.","match":{"names":["\\b(reload|refresh)\\b"]}},
    {"id":"hard-reload","native_id":33007,"shortcut":"Ctrl+Shift+R","description":"reload while ignoring cached content.","match":{"names":["hard reload|reload.*cache|empty cache"]}},
    {"id":"bookmark-page","shortcut":"Ctrl+D","description":"bookmark this page.","match":{"names":["\\b(add )?bookmark( this (page|tab))?\\b"]}},
    {"id":"bookmarks-manager","shortcut":"Ctrl+Shift+O","description":"open the Bookmarks Manager.","match":{"names":["bookmark manager"]}},
    {"id":"bookmarks-bar","shortcut":"Ctrl+Shift+B","description":"show or hide the bookmarks bar.","match":{"names":["bookmarks bar"]}},
    {"id":"history","shortcut":"Ctrl+H","description":"open browsing history.","match":{"names":["\\bhistory\\b"]}},
    {"id":"downloads","shortcut":"Ctrl+J","description":"open downloads.","match":{"names":["\\bdownloads?\\b"]}},
    {"id":"find","shortcut":"Ctrl+F","description":"find text on this page.","match":{"names":["\\bfind\\b"]}},
    {"id":"print","shortcut":"Ctrl+P","description":"print this page.","match":{"names":["\\bprint\\b"]}},
    {"id":"save-page","shortcut":"Ctrl+S","description":"save this page.","match":{"names":["\\bsave page\\b"]}},
    {"id":"open-file","native_id":40000,"shortcut":"Ctrl+O","description":"open a local file.","match":{"names":["open file"]}},
    {"id":"developer-tools","shortcut":"Ctrl+Shift+J / F12","description":"open Developer Tools.","match":{"names":["developer tools"]}},
    {"id":"clear-browsing-data","shortcut":"Ctrl+Shift+Delete","description":"open Clear Browsing Data.","match":{"names":["clear browsing data"]}},
    {"id":"profile-menu","shortcut":"Ctrl+Shift+M","description":"open the profile menu.","match":{"names":["\\b(profile|account)\\b"],"roles":["button|push button"]}},
    {"id":"task-manager","shortcut":"Shift+Esc","description":"open the browser's task manager.","match":{"names":["task manager"]}},
    {"id":"zoom-in","shortcut":"Ctrl++","description":"zoom in.","match":{"names":["zoom in"]}},
    {"id":"zoom-out","shortcut":"Ctrl+-","description":"zoom out.","match":{"names":["zoom out"]}},
    {"id":"zoom-reset","shortcut":"Ctrl+0","description":"reset page zoom.","match":{"names":["reset zoom|100%"]}},
    {"id":"fullscreen","shortcut":"F11","description":"toggle full-screen mode.","match":{"names":["full.?screen"]}},
    {"id":"view-source","native_id":35002,"shortcut":"Ctrl+U","description":"view page source.","match":{"names":["view (page )?source"]}},
    {"id":"screenshot","shortcut":"Ctrl+Shift+S","description":"capture a screenshot.","match":{"names":["screenshot|capture"]}},
    {"id":"help","shortcut":"F1","description":"open the browser's help center.","match":{"names":["\\bhelp( center)?\\b"]}}
  ]
}
