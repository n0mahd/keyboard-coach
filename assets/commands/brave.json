{
  "schema_version": 1,
  "id": "brave",
  "apps": ["^(brave|brave-browser(-(beta|dev|nightly))?|com\\.brave\\.Browser.*)$"],
  "accelerator_source": "chromium_preferences",
  "default_match": {"target_in_document": ["^false$"]},
  "source": {"title": "Brave command registry", "url": "https://github.com/brave/brave-core/blob/master/app/brave_command_ids.h", "platform": "linux", "retrieved": "2026-09-20"},
  "commands": [
    {"id":"collapse-vertical-tabs","native_id":34061,"shortcut":"Ctrl+Shift+L","description":"collapse or expand vertical tabs.","match":{"names":["(collapse|expand).*vertical tabs"]}},
    {"id":"new-tor-window","native_id":56003,"shortcut":"Alt+Shift+N","description":"open a new private window with Tor.","match":{"names":["new private window with tor|new tor window"]}},
    {"id":"toggle-tab-mute","native_id":56041,"shortcut":"Ctrl+M","description":"mute or unmute the current tab.","match":{"names":["mute (site|tab)|unmute (site|tab)"]}},
    {"id":"toggle-sidebar","native_id":56044,"shortcut":"Ctrl+B","description":"show or hide the Brave sidebar.","match":{"names":["show sidebar|hide sidebar|toggle sidebar"]}},
    {"id":"quick-commands","native_id":56301,"shortcut":"Ctrl+Space","description":"open Brave Quick Commands.","match":{"names":["quick commands|command palette"]}}
  ]
}
