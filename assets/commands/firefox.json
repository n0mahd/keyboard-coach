{
  "schema_version": 1,
  "id": "firefox",
  "apps": ["^(firefox|firefox-esr|firefox-developer-edition|firefox-nightly|navigator|org\\.mozilla\\.(firefox|Firefox).*)$", "^(zen|zen-alpha|zen-browser|app\\.zen_browser\\.zen.*)$", "^(librewolf|io\\.gitlab\\.librewolf-community.*|floorp|waterfox|mullvad-browser|tor-?browser.*)$"],
  "default_match": {"target_in_document": ["^false$"]},
  "source": {"title": "Keyboard shortcuts - Perform common Firefox tasks quickly", "url": "https://support.mozilla.org/en-US/kb/keyboard-shortcuts-perform-firefox-tasks-quickly", "platform": "linux", "retrieved": "2026-09-20"},
  "commands": [
    {"id":"select-tab-direct","shortcut":"Alt+{target_position} / Ctrl+{target_position}","description":"switch directly to this tab.","priority":240,"match":{"roles":["^page tab$"],"target_positions":["^[1-8]$"],"buttons":["left"]}},
    {"id":"select-last-tab","shortcut":"Alt+9 / Ctrl+9","description":"switch to the last tab.","priority":235,"match":{"roles":["^page tab$"],"target_is_last":["^true$"],"buttons":["left"]}},
    {"id":"select-tab","shortcut":"Ctrl+Tab / Ctrl+Shift+Tab","description":"switch to the next or previous tab.","priority":220,"match":{"roles":["^page tab$"],"buttons":["left"]}},
    {"id":"close-tab-button","shortcut":"Ctrl+W","description":"close the current tab.","priority":180,"match":{"roles":["^(button|push button)$"],"names":["^close tab$|^close$"],"parent_roles":["^page tab$"],"target_parent_selected":["^true$"]}},
    {"id":"new-tab","shortcut":"Ctrl+T","description":"open a new tab.","priority":220,"match":{"names":["\\bnew tab\\b|open a new tab"]}},
    {"id":"new-window","shortcut":"Ctrl+N","description":"open a new window.","match":{"names":["^new window$|open a new window"]}},
    {"id":"new-private-window","shortcut":"Ctrl+Shift+P","description":"open a new private window.","match":{"names":["new private window"]}},
    {"id":"close-tab","shortcut":"Ctrl+W","description":"close the current tab.","priority":180,"match":{"names":["\\bclose tab\\b"]}},
    {"id":"close-window","shortcut":"Ctrl+Shift+W","description":"close the browser window.","match":{"names":["close window|\\b(exit|quit)\\b"]}},
    {"id":"reopen-closed-tab","shortcut":"Ctrl+Shift+T","description":"reopen the last closed tab.","match":{"names":["reopen.*closed tab|undo close tab|recently closed tabs"]}},
    {"id":"back","shortcut":"Alt+Left","description":"go back.","match":{"names":["\\bback\\b|go back"]}},
    {"id":"forward","shortcut":"Alt+Right","description":"go forward.","match":{"names":["\\bforward\\b|go forward"]}},
    {"id":"reload","shortcut":"Ctrl+R / F5","description":"reload the page.","match":{"names":["\\b(reload|refresh)\\b"]}},
    {"id":"hard-reload","shortcut":"Ctrl+Shift+R","description":"reload while ignoring cached content.","match":{"names":["hard reload|reload.*cache|override cache"]}},
    {"id":"stop-loading","shortcut":"Esc","description":"stop loading the page.","match":{"names":["^stop$|stop loading"]}},
    {"id":"home","shortcut":"Alt+Home","description":"open the home page.","match":{"names":["\\bhome\\b"]}},
    {"id":"address-bar","shortcut":"Ctrl+L / Alt+D","description":"focus the address bar.","match":{"names":["address|awesome ?bar|search with .*(or )?enter|location"]}},
    {"id":"search-bar","shortcut":"Ctrl+K","description":"search from the address bar.","match":{"names":["^search$|search bar|web search"]}},
    {"id":"find","shortcut":"Ctrl+F","description":"find text on this page.","match":{"names":["^find( in page)?(\\.\\.\\.|…)?$|find in this page"]}},
    {"id":"find-again","shortcut":"Ctrl+G / F3","description":"go to the next find result.","match":{"names":["find again|next match|highlight all"]}},
    {"id":"bookmark-page","shortcut":"Ctrl+D","description":"bookmark this page.","match":{"names":["bookmark (this |current )?(page|tab)|^add bookmark|edit this bookmark"]}},
    {"id":"bookmark-all-tabs","shortcut":"Ctrl+Shift+D","description":"bookmark all open tabs.","match":{"names":["bookmark all tabs"]}},
    {"id":"bookmarks-sidebar","shortcut":"Ctrl+B","description":"show or hide the bookmarks sidebar.","match":{"names":["bookmarks sidebar|view bookmarks sidebar"]}},
    {"id":"bookmarks-toolbar","shortcut":"Ctrl+Shift+B","description":"show or hide the bookmarks toolbar.","match":{"names":["bookmarks toolbar"]}},
    {"id":"bookmarks-manager","shortcut":"Ctrl+Shift+O","description":"open the bookmarks library.","match":{"names":["manage bookmarks|bookmark manager|show all bookmarks"]}},
    {"id":"history","shortcut":"Ctrl+H","description":"open the history sidebar.","match":{"names":["\\bhistory\\b"]}},
    {"id":"downloads","shortcut":"Ctrl+Shift+Y","description":"open downloads.","match":{"names":["\\bdownloads?\\b"]}},
    {"id":"add-ons","shortcut":"Ctrl+Shift+A","description":"open Add-ons and Themes.","match":{"names":["add-?ons|extensions and themes|manage extensions"]}},
    {"id":"clear-history","shortcut":"Ctrl+Shift+Delete","description":"open Clear Recent History.","match":{"names":["clear.*(history|browsing data)|forget about this site"]}},
    {"id":"print","shortcut":"Ctrl+P","description":"print this page.","match":{"names":["^print(\\.\\.\\.|…)?$|print this page"]}},
    {"id":"save-page","shortcut":"Ctrl+S","description":"save this page.","match":{"names":["save page|save as"]}},
    {"id":"open-file","shortcut":"Ctrl+O","description":"open a local file.","match":{"names":["open file"]}},
    {"id":"zoom-in","shortcut":"Ctrl++","description":"zoom in.","match":{"names":["zoom in|enlarge"]}},
    {"id":"zoom-out","shortcut":"Ctrl+-","description":"zoom out.","match":{"names":["zoom out|reduce"]}},
    {"id":"zoom-reset","shortcut":"Ctrl+0","description":"reset page zoom.","match":{"names":["reset zoom|100%"]}},
    {"id":"fullscreen","shortcut":"F11","description":"toggle full-screen mode.","match":{"names":["full.?screen"]}},
    {"id":"reader-view","shortcut":"Ctrl+Alt+R","description":"toggle Reader View.","match":{"names":["reader view|toggle reader"]}},
    {"id":"view-source","shortcut":"Ctrl+U","description":"view page source.","match":{"names":["view (page )?source"]}},
    {"id":"developer-tools","shortcut":"F12 / Ctrl+Shift+I","description":"open the developer tools.","match":{"names":["developer tools|web developer|inspect"]}},
    {"id":"web-console","shortcut":"Ctrl+Shift+K","description":"open the Web Console.","match":{"names":["web console|javascript console"]}},
    {"id":"mute-tab","shortcut":"Ctrl+M","description":"mute or unmute the current tab.","match":{"names":["mute tab|unmute tab|^(un)?mute this tab$"]}},
    {"id":"caret-browsing","shortcut":"F7","description":"toggle caret browsing.","match":{"names":["caret browsing"]}}
  ]
}
